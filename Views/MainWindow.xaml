<Window x:Class="MiniSoundpad.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mini Soundpad" Width="900" Height="580" MinWidth="640" MinHeight="380"
        Icon="/Assets/app.ico"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <DockPanel>
        <!-- 工具栏 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,6">
            <Button Content="＋ 添加音效" Click="Add_Click" />
            <Button Content="● 录音" Click="Record_Click" />
            <Button x:Name="StopAllButton" Content="■ 全部停止" Click="StopAll_Click" />
            <Button Content="⚙ 设置" Click="Settings_Click" />
            <TextBlock Text="搜索：" VerticalAlignment="Center" Margin="16,0,4,0" />
            <TextBox x:Name="SearchBox" Width="160" VerticalContentAlignment="Center" TextChanged="Filter_Changed" />
            <TextBlock Text="分类：" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox x:Name="CategoryBox" Width="120" SelectionChanged="Filter_Changed" />
        </StackPanel>

        <!-- 状态栏 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>
        <TextBlock DockPanel.Dock="Bottom" x:Name="WarningText" Foreground="#C62828"
                   TextWrapping="Wrap" Margin="10,0,10,4" Visibility="Collapsed" />

        <!-- 音效列表 -->
        <Grid Margin="10,0,10,6">
            <ListView x:Name="SoundList" SelectionMode="Extended"
                      MouseDoubleClick="SoundList_MouseDoubleClick" KeyDown="SoundList_KeyDown">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                <Setter Property="Foreground" Value="Gray" />
                                <Setter Property="ToolTip" Value="文件不存在（被移动或删除了）" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="48">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="▶" MinWidth="0" Width="30" Padding="0" Margin="0"
                                            Click="PlayButton_Click" ToolTip="播放" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="名称" Width="300" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="分类" Width="120" DisplayMemberBinding="{Binding Category}" />
                        <GridViewColumn Header="快捷键" Width="140" DisplayMemberBinding="{Binding HotkeyText}" />
                        <GridViewColumn Header="音量" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="120" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                                Value="{Binding Volume, Mode=TwoWay}" />
                                        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                                                   Text="{Binding Volume, StringFormat={}{0:P0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="▶ 播放" Click="MenuPlay_Click" />
                        <Separator />
                        <MenuItem Header="设置快捷键…" Click="MenuHotkey_Click" />
                        <MenuItem Header="重命名…" Click="MenuRename_Click" />
                        <MenuItem Header="设置分类…" Click="MenuCategory_Click" />
                        <MenuItem Header="剪辑…" Click="MenuTrim_Click" />
                        <Separator />
                        <MenuItem Header="在资源管理器中显示" Click="MenuReveal_Click" />
                        <MenuItem Header="从列表中删除" Click="MenuDelete_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="Gray" FontSize="15" TextAlignment="Center" IsHitTestVisible="False"
                       Text="把音频文件拖到这里，或点「添加音效」 / 「录音」&#x0a;支持 wav / mp3 / m4a / flac / wma / aac" />
        </Grid>
    </DockPanel>
</Window>

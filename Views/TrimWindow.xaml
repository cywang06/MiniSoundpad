<Window x:Class="MiniSoundpad.Views.TrimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:MiniSoundpad.Views"
        Title="剪辑" Width="760" Height="380" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closed="Window_Closed">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontWeight="SemiBold" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,8"
                   Text="在波形上点击/拖动来移动最近的边界（黄线），或用下面的滑块精调。" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="▶ 试听选区" Click="Preview_Click" />
            <Button Content="■ 停止" Click="StopPreview_Click" />
            <TextBlock x:Name="LengthText" VerticalAlignment="Center" Margin="10,0" />
            <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" Margin="40,0,6,0" />
            <Button Content="取消" Click="Cancel_Click" Margin="0" />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock Text="开始：" VerticalAlignment="Center" />
            <Slider x:Name="StartSlider" Grid.Column="1" ValueChanged="Slider_ValueChanged" SmallChange="0.01" LargeChange="0.1" />
            <TextBlock x:Name="StartText" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" />
            <TextBlock Grid.Row="1" Text="结束：" VerticalAlignment="Center" />
            <Slider x:Name="EndSlider" Grid.Row="1" Grid.Column="1" ValueChanged="Slider_ValueChanged" SmallChange="0.01" LargeChange="0.1" />
            <TextBlock x:Name="EndText" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0" />
        </Grid>

        <v:WaveformView x:Name="Wave" Cursor="SizeWE" />
    </DockPanel>
</Window>

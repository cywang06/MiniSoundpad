<Window x:Class="MiniSoundpad.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="0,0,0,8" TextWrapping="Wrap" />
        <ComboBox x:Name="InputBox" IsEditable="True" Padding="4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" IsDefault="True" Click="Ok_Click" />
            <Button Content="取消" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>

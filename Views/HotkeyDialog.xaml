<Window x:Class="MiniSoundpad.Views.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置快捷键" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="16">
        <TextBlock x:Name="TargetText" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Foreground="Gray"
                   Text="直接按下想用的组合键。建议用 Ctrl/Alt + 某键、F13–F24 或小键盘键，避免占用打字常用的键。" />
        <Border BorderBrush="#888" BorderThickness="1" CornerRadius="4" Margin="0,12" Padding="8" Background="#F4F4F4">
            <TextBlock x:Name="KeyText" FontSize="20" HorizontalAlignment="Center" Text="（等待按键…）" />
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Click="Ok_Click" Focusable="False" />
            <Button Content="清除快捷键" Click="Clear_Click" Focusable="False" />
            <Button Content="取消" Click="Cancel_Click" Focusable="False" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
